#!/usr/bin/env python3
"""split-strict-baseline: regenerate a package's split-strict gate inputs.

Usage:
  scripts/split-strict-baseline <package-dir> <run>...

<package-dir> is cmd/gc or internal/api. Each <run> is a gate directory or a
bazel-testlogs tree of a FULL GC_TEST_SPLIT_STRICT=1 run of that package
(every shard), for example

  bazel test --remote_download_outputs=all //internal/api:api_split_strict_test
  scripts/split-strict-baseline internal/api bazel-testlogs/internal/api/api_split_strict_test

It reads every shard's observed table from its test.log (the gate prints it
there, so a remote run's logs suffice; e.g. the split-strict lane's
bazel-split-strict-testlogs artifact), else from split-strict-observed.tsv
(plain, or inside test.outputs/outputs.zip), and rewrites:

  <package-dir>/testdata/split_strict_baseline.tsv
      one row per violation key. Per-key test counts add up across shards
      (each test runs in one); max_lines is the number of distinct offending
      lines of the key's function across the whole run. A key the old baseline
      already lists keeps its verdict and note; a new key gets verdict
      "triage", which fails the ratchet until someone rules on it. A key the
      run did not reach is dropped, which is why the run must be full.
  <package-dir>/testdata/split_strict_known_failures.list
      every top-level test that failed (from the test logs' "--- FAIL:" lines).

The header comment blocks are kept. Rows are sorted in byte order (LC_ALL=C).
Review the result with git diff.
"""

import collections
import glob
import io
import os
import re
import sys
import zipfile

OBSERVED = "split-strict-observed.tsv"


def header(path):
    lines = []
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            for line in f:
                if not line.startswith("#"):
                    break
                lines.append(line)
    return "".join(lines)


TABLE_BEGIN = "SPLIT-STRICT TABLE BEGIN " + OBSERVED
TABLE_END = "SPLIT-STRICT TABLE END"


def tables_in_log(text):
    """Yield the observed tables a gate run printed into its test log."""
    lines = None
    for line in text.splitlines():
        if line.strip() == TABLE_BEGIN:
            lines = []
        elif line.strip() == TABLE_END and lines is not None:
            yield "\n".join(lines) + "\n"
            lines = None
        elif lines is not None:
            lines.append(line)


def observed_tables(run):
    if os.path.isfile(run):
        with open(run, encoding="utf-8", errors="replace") as f:
            text = f.read()
        found = list(tables_in_log(text))
        yield from (found or [text])
        return
    logs = glob.glob(os.path.join(run, "**", "test.log"), recursive=True)
    from_logs = []
    for path in logs:
        with open(path, encoding="utf-8", errors="replace") as f:
            from_logs.extend(tables_in_log(f.read()))
    if from_logs:
        yield from from_logs
        return
    for path in glob.glob(os.path.join(run, "**", OBSERVED), recursive=True):
        with open(path, encoding="utf-8") as f:
            yield f.read()
    for path in glob.glob(os.path.join(run, "**", "outputs.zip"), recursive=True):
        with zipfile.ZipFile(path) as z:
            for name in z.namelist():
                if name.endswith(OBSERVED):
                    yield z.read(name).decode("utf-8")


def failing_tests(run):
    failed = set()
    if not os.path.isdir(run):
        return failed
    pattern = re.compile(r"^--- FAIL: (Test\S+) \(")
    for path in glob.glob(os.path.join(run, "**", "test.log"), recursive=True):
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                m = pattern.match(line)
                if m and "/" not in m.group(1):
                    failed.add(m.group(1))
    return failed


def main(argv):
    if len(argv) < 3:
        sys.stderr.write(__doc__)
        return 2
    pkg = argv[1].rstrip("/")
    runs = argv[2:]
    baseline_path = os.path.join(pkg, "testdata", "split_strict_baseline.tsv")
    known_path = os.path.join(pkg, "testdata", "split_strict_known_failures.list")

    old = {}
    if os.path.exists(baseline_path):
        with open(baseline_path, encoding="utf-8") as f:
            for line in f:
                if line.startswith("#") or not line.strip():
                    continue
                cols = line.rstrip("\n").split("\t")
                if len(cols) == 10:
                    old[tuple(cols[:6])] = (cols[8], cols[9])

    lines = collections.defaultdict(set)
    tests = collections.Counter()
    tables = 0
    for run in runs:
        for table in observed_tables(run):
            tables += 1
            for line in io.StringIO(table):
                if line.startswith("#") or not line.strip():
                    continue
                cols = line.rstrip("\n").split("\t")
                if len(cols) != 11:
                    continue
                key = tuple(cols[:6])
                lines[key].update(int(n) for n in cols[6].split(",") if n)
                tests[key] += int(cols[7])
    if tables == 0:
        sys.stderr.write("split-strict-baseline: no %s found in %s\n" % (OBSERVED, " ".join(runs)))
        return 1

    func_lines = collections.defaultdict(set)
    for key, ls in lines.items():
        func_lines[(key[0], key[1])].update(ls)

    rows = []
    for key in lines:
        verdict, note = old.get(key, ("triage", "unadjudicated"))
        rows.append("\t".join(list(key) + [str(len(func_lines[(key[0], key[1])])), str(tests[key]), verdict, note]))
    rows.sort(key=lambda r: r.encode("utf-8"))
    with open(baseline_path, "w", encoding="utf-8") as f:
        f.write(header(baseline_path) + "".join(r + "\n" for r in rows))

    failed = set()
    for run in runs:
        failed |= failing_tests(run)
    with open(known_path, "w", encoding="utf-8") as f:
        f.write(header(known_path) + "".join(t + "\n" for t in sorted(failed, key=lambda s: s.encode("utf-8"))))

    triage = sum(1 for r in rows if r.split("\t")[8] == "triage")
    sys.stderr.write("split-strict-baseline: %d key(s) (%d to triage) in %s; %d known failure(s) in %s\n"
                     % (len(rows), triage, baseline_path, len(failed), known_path))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
